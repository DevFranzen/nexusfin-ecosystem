# ==============================================
# Exchange Infrastructure Configuration
# ==============================================

# --- PostgreSQL Database ---
POSTGRES_USER=user
POSTGRES_PASSWORD=<set-your-password>
POSTGRES_DB=mydb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Keycloak Database ---
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_DB_USERNAME=user
KC_DB_PASSWORD=<set-your-password>

# --- Keycloak Admin Credentials ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<set-your-password>

# --- Grafana Admin Credentials ---
GF_SECURITY_ADMIN_PASSWORD=<set-your-password>

# --- Redpanda Configuration ---
REDPANDA_NODE_ID=0
REDPANDA_SMP=1
REDPANDA_MEMORY=512M
REDPANDA_RESERVE_MEMORY=0M

# --- Resource Limits (in MB) ---
POSTGRES_MEMORY_LIMIT=256M
QDRANT_MEMORY_LIMIT=512M
PROMETHEUS_MEMORY_LIMIT=256M
GRAFANA_MEMORY_LIMIT=256M
LOKI_MEMORY_LIMIT=256M
KEYCLOAK_MEMORY_LIMIT=750M

# --- Embedding Model ---
AI_MODEL=embeddinggemma